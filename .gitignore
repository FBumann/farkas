__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg
.eggs/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/
*.so
.env
.venv/
venv/
.idea/
uv.lock

# generated benchmark inputs (regenerated deterministically from bench/cases.py;
# the results JSONL under bench/results/ *is* tracked — that is the provenance)
bench/.cache/
# pytest-benchmark's run store; baselines to compare against are chosen by
# number at the command line, not committed
.benchmarks/

# spike outputs (scripts are tracked; data/LP artifacts are not)
scratch/relational_spike/*_data/
scratch/relational_spike/bench_out/
scratch/relational_spike/*.lp
.DS_Store

# rendered presentation output (sources docs/*.md + docs/*.svg are tracked)
docs/*.html
docs/*.pdf
